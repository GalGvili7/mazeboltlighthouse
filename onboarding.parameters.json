// =============================================================================
// Parameters for onboarding.json  -  edit the three values you actually own.
// -----------------------------------------------------------------------------
// You (MazeBolt) fill these in ONCE and ship this file with the template. The
// customer does not need to edit anything (unless they want to name the offer).
// =============================================================================
{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {

    // [OPTIONAL] Override the offer name/description if you like.
    "mspOfferName":        { "value": "MazeBolt DDoS WAF Automation" },
    "mspOfferDescription": { "value": "Lets MazeBolt apply/update Front Door WAF custom rules on request." },

    // [MUST] YOUR tenant ID. Find it: Entra ID > Overview > Tenant ID.
    "managedByTenantId": { "value": "80fc0aef-83fb-4e0f-a8c8-456ac42c0cde" },

    // [MUST] Who in YOUR tenant gets access, and with which built-in role.
    "authorizations": {
      "value": [
        {
          // [MUST] Object ID of the service principal your PLATFORM signs in as.
          // Find it: Entra ID > Enterprise applications > (your app) > Object ID.
          // (Use the ENTERPRISE APP / service principal object ID, not the app
          //  registration's Application (client) ID.)
          "principalId": "115e6d89-a737-44b2-b635-8f5b485fb067",

          // [MUST] Any label - shown to the customer for transparency.
          "principalIdDisplayName": "MazeBolt WAF automation (service principal)",

          // [MUST] Built-in role GUID. Network Contributor = can read/write
          // Microsoft.Network resources (covers Front Door WAF policies) but
          // cannot touch non-network resources or assign roles.
          //   Network Contributor = 4d97b98b-1d4f-4787-a291-c67834d212e7
          // Tighter than Contributor; it is the least-privilege BUILT-IN option.
          // (A truly WAF-only CUSTOM role is NOT usable here - Lighthouse blocks
          //  custom roles. See README for the alternative pattern if you need it.)
          "roleDefinitionId": "4d97b98b-1d4f-4787-a291-c67834d212e7"
        }

        // ------------------------------------------------------------------
        // [OPTIONAL] Add more principals/roles by appending objects, e.g.:
        //
        // ,{
        //   // Lets MazeBolt REMOVE its own delegation later (clean self-service
        //   // offboarding). Role: "Managed Services Registration assignment
        //   // Delete Role" = 91c1777a-f3dc-4fae-b103-61d183457e46
        //   "principalId": "11111111-1111-1111-1111-111111111111",
        //   "principalIdDisplayName": "MazeBolt offboarding",
        //   "roleDefinitionId": "91c1777a-f3dc-4fae-b103-61d183457e46"
        // }
        //
        // ,{
        //   // A read-only principal (e.g. your dashboards). Reader =
        //   // acdd72a7-3385-48ef-bd42-f606fba81ae7
        //   "principalId": "22222222-2222-2222-2222-222222222222",
        //   "principalIdDisplayName": "MazeBolt read-only",
        //   "roleDefinitionId": "acdd72a7-3385-48ef-bd42-f606fba81ae7"
        // }
        // ------------------------------------------------------------------
      ]
    }
  }
}
